{
    "name": "apiverve/hardinesszone",
    "description": "USDA Hardiness Zone looks up the plant hardiness zone by ZIP code, mapping any US ZIP code to its zone title and temperature range. Paid plans add the zone classification code, Celsius values, and plant survival recommendations.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "hardinesszone",
        "usda hardiness zone api",
        "plant hardiness zone api",
        "usda hardiness zone by zip code",
        "hardiness zone by zip code",
        "growing zones by zip code"
    ],
    "homepage": "https://apiverve.com/marketplace/hardinesszone?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/hardinesszone",
        "source": "https://github.com/apiverve/hardinesszone-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Hardinesszone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Hardinesszone\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
